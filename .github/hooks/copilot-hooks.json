{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ci/hooks/post-edit-lint.mjs \"$TOOL_INPUT_FILE_PATH\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ci/hooks/on-stop-health.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
