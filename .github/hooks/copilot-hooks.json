{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/scripts/hooks/post-edit-lint.mjs \"$TOOL_INPUT_FILE_PATH\"",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/scripts/hooks/on-stop-health.mjs",
        "timeout": 120
      }
    ]
  }
}
