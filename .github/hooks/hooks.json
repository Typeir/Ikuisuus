{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .paw/hooks/post-tool-use.mjs",
        "windows": "node .paw/hooks/post-tool-use.mjs",
        "linux": "node .paw/hooks/post-tool-use.mjs",
        "osx": "node .paw/hooks/post-tool-use.mjs",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .paw/hooks/pre-tool-use.mjs",
        "windows": "node .paw/hooks/pre-tool-use.mjs",
        "linux": "node .paw/hooks/pre-tool-use.mjs",
        "osx": "node .paw/hooks/pre-tool-use.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .paw/hooks/session-end-health.mjs",
        "windows": "node .paw/hooks/session-end-health.mjs",
        "linux": "node .paw/hooks/session-end-health.mjs",
        "osx": "node .paw/hooks/session-end-health.mjs",
        "cwd": ".",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "node .paw/hooks/session-end-memory-save.mjs",
        "windows": "node .paw/hooks/session-end-memory-save.mjs",
        "linux": "node .paw/hooks/session-end-memory-save.mjs",
        "osx": "node .paw/hooks/session-end-memory-save.mjs",
        "cwd": ".",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "node .paw/hooks/session-end-missing-tests.mjs",
        "windows": "node .paw/hooks/session-end-missing-tests.mjs",
        "linux": "node .paw/hooks/session-end-missing-tests.mjs",
        "osx": "node .paw/hooks/session-end-missing-tests.mjs",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .paw/hooks/user-prompt-submitted.mjs",
        "windows": "node .paw/hooks/user-prompt-submitted.mjs",
        "linux": "node .paw/hooks/user-prompt-submitted.mjs",
        "osx": "node .paw/hooks/user-prompt-submitted.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}