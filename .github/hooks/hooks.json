{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .paw/hooks/postToolUse.mjs",
        "windows": "node .paw/hooks/postToolUse.mjs",
        "linux": "node .paw/hooks/postToolUse.mjs",
        "osx": "node .paw/hooks/postToolUse.mjs",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .paw/hooks/preToolUse.mjs",
        "windows": "node .paw/hooks/preToolUse.mjs",
        "linux": "node .paw/hooks/preToolUse.mjs",
        "osx": "node .paw/hooks/preToolUse.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .paw/hooks/sessionEndHealth.mjs",
        "windows": "node .paw/hooks/sessionEndHealth.mjs",
        "linux": "node .paw/hooks/sessionEndHealth.mjs",
        "osx": "node .paw/hooks/sessionEndHealth.mjs",
        "cwd": ".",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "node .paw/hooks/sessionEndMemorySave.mjs",
        "windows": "node .paw/hooks/sessionEndMemorySave.mjs",
        "linux": "node .paw/hooks/sessionEndMemorySave.mjs",
        "osx": "node .paw/hooks/sessionEndMemorySave.mjs",
        "cwd": ".",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "node .paw/hooks/sessionEndMissingTests.mjs",
        "windows": "node .paw/hooks/sessionEndMissingTests.mjs",
        "linux": "node .paw/hooks/sessionEndMissingTests.mjs",
        "osx": "node .paw/hooks/sessionEndMissingTests.mjs",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .paw/hooks/userPromptSubmitted.mjs",
        "windows": "node .paw/hooks/userPromptSubmitted.mjs",
        "linux": "node .paw/hooks/userPromptSubmitted.mjs",
        "osx": "node .paw/hooks/userPromptSubmitted.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}