# Git history — huge pack files not needed
.git
.gitignore

# Webpack + Next cache
.next/cache

# Local dependencies and lockfiles (Vercel installs clean)
node_modules
package-lock.json
pnpm-lock.yaml
yarn.lock

# Heavy assets not needed server-side
public/library/resources
.next/cache/webpack  

# Repo metadata and local tooling
.github
.vscode
.husky
.ignore
.logs
.meta

# Local env files
.env
.env.*

# Development-only routes. Labs reads fixtures and other local-only files, so
# it has no business in a deployment and cannot break one it never reaches.
**/labs/dev

# Test and coverage outputs
coverage
tests
playwright-report
test-results
vitest-report.json

# Temporary and generated local files
temp
*.log
*.tsbuildinfo
migrate.log