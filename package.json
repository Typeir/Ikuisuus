{
  "name": "ikuisuus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run pre-init && next dev",
    "start": "npm run pre-init && next start",
    "lint": "next lint",
    "compress-assets": "node scripts/assets/compressAssets.js",
    "kebabify-content": "node scripts/content/kebabifyContent.js",
    "md-to-mdx": "node scripts/content/mdToMdx.js",
    "find-reusable-mdx-outliers": "node scripts/content/findReusableMdxOutliers.js",
    "clean-fullsize-forced": "rm -rf public/full-size",
    "clean-fullsize": "node scripts/build/cleanFullSize.js",
    "merge-locales": "node scripts/i18n/mergeMessages.js",
    "clean-translations": "node scripts/i18n/cleanTranslations.js",
    "pre-init": "npm run compress-assets && npm run kebabify-content && npm run md-to-mdx && npm run generate-metadata && npm run merge-locales && npm run find-reusable-mdx-outliers",
    "pre-init:ci": "npm run kebabify-content && npm run md-to-mdx && npm run generate-metadata && npm run merge-locales && npm run find-reusable-mdx-outliers:ci",
    "find-reusable-mdx-outliers:ci": "node scripts/content/findReusableMdxOutliers.ci.js",
    "linkify:world:dry": "node scripts/content/linkifyRunner.mjs --links scripts/core/links.json --root src/content/en/world",
    "linkify:world": "node scripts/content/linkifyRunner.mjs --links scripts/core/links.json --root src/content/en/world --write --backup",
    "scaffold:world:dry": "node scripts/content/scaffoldFromLinks.mjs --links scripts/core/links.json --world-root src/content/en/world --dry",
    "scaffold:world": "node scripts/content/scaffoldFromLinks.mjs --links scripts/core/links.json --world-root src/content/en/world",
    "clean": "npm run clean-fullsize && npm run clean-translations && rm -rf ./stl",
    "build": "rm -rf .next/cache && npm run pre-init && npm run test && next build",
    "build:ci": "rm -rf .next/cache && npm run pre-init:ci && npm run test && next build",
    "build:vercel": "rm -rf .next/cache && npm run pre-init && next build",
    "pagefind": "pagefind --site .next --output-path .next/static/chunks/app/pagefind",
    "generate-metadata": "npx tsx --tsconfig tsconfig.scripts.json scripts/metadata/generateMetadata.ts",
    "util:precompile-mdx": "node scripts/utils/precompileMdx.js",
    "util:mdxify-heading-images": "node scripts/utils/mdxifyHeadingImages.js",
    "util:scrap-wikidot": "node scripts/utils/scrapWikidot.js",
    "util:scrap-wikidot-spells": "node scripts/utils/scrapWikidotSpells.js",
    "util:tree-size": "node scripts/utils/treeSize.js ./src",
    "util:test-metadata": "node scripts/utils/testMetadataSystem.mjs",
    "db:init": "node scripts/db/pg/init-db.mjs",
    "db:migrate": "node scripts/db/pg/migrate.mjs",
    "db:seed": "npx tsx scripts/db/pg/seed-from-fs.ts",
    "db:backfill-spell-lists": "node scripts/db/pg/backfill-spell-lists.mjs",
    "multirepo:setup": "bash scripts/multirepo/setup-hooks.sh",
    "multirepo:help": "bash scripts/multirepo/ik.sh help",
    "multirepo:extract": "bash scripts/migration/extract-content-repo.sh",
    "multirepo:toggle": "bash scripts/migration/toggle-content-submodule.sh",
    "wip:bundle-metadata": "node scripts/wip/bundleMonsterMetadata.js && node scripts/wip/bundleHeirloomMetadata.js",
    "health:check": "node scripts/ci/health-check.mjs",
    "health:file-length": "node scripts/ci/check-file-length.mjs",
    "health:duplicate-css": "node scripts/ci/check-duplicate-css.mjs",
    "health:jsdoc": "node scripts/ci/check-jsdoc-quality.mjs",
    "health:antipatterns": "node scripts/ci/check-antipatterns.mjs",
    "health:test-gaps": "node scripts/ci/check-test-gaps.mjs",
    "health:reconcile": "node scripts/ci/reconcile-task.mjs",
    "health:report": "node scripts/ci/write-report.mjs",
    "test": "npm run test:enforce && node tests/scripts/runTests.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=vitest-report.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:file": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual --update-snapshots",
    "test:enforce": "node tests/scripts/enforceCoverage.mjs",
    "test:templates": "node tests/scripts/generateTestTemplates.mjs",
    "test:all": "npm run test:enforce && npm run test && npm run test:e2e",
    "test:hooks": "bash scripts/hooks/test-hooks.sh",
    "generate-token": "node scripts/auth/generateToken.mjs",
    "seed-admin": "node scripts/auth/seedAdmin.mjs",
    "seed-admin-pg": "node scripts/auth/seedAdminPg.mjs",
    "test-pat": "node scripts/test-pat.js",
    "lottery": "node scripts/utils/mdxLottery.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/mdx": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@mikro-orm/core": "^6.6.9",
    "@mikro-orm/postgresql": "^6.6.9",
    "@neondatabase/serverless": "^1.0.2",
    "@next/mdx": "^15.3.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/pg": "^8.18.0",
    "@types/three": "^0.183.1",
    "@vercel/edge-config": "^1.4.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.576.0",
    "mdx-bundler": "^10.1.1",
    "next": "^15.4.8",
    "next-intl": "^4.3.4",
    "next-mdx-remote-client": "^2.1.2",
    "pg": "^8.20.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-simple-code-editor": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.89.2",
    "three": "^0.183.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mikro-orm/reflection": "^6.6.9",
    "@playwright/test": "^1.40.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.7",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.1.0",
    "acorn": "^8.11.3",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.2",
    "autoprefixer": "^10",
    "dotenv": "^17.3.1",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^8",
    "eslint-config-next": "13.5.11",
    "globby": "^14.1.0",
    "happy-dom": "^12.10.3",
    "husky": "^9.1.7",
    "is-arguments": "^1.1.1",
    "jsdom": "^27.2.0",
    "node-fetch": "^3.3.2",
    "pagefind": "^1.4.0",
    "playwright": "^1.54.1",
    "postcss": "^8",
    "sharp": "^0.34.3",
    "tailwindcss": "^3",
    "ts-morph": "^26.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "vitest": "^1.1.0"
  }
}
