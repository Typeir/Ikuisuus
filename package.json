{
  "name": "ikuisuus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx --tsconfig tsconfig.scripts.json scripts/dev/runDev.ts",
    "start": "npm run build:vercel && next start",
    "lint": "next lint",
    "compress-assets": "npx tsx --tsconfig tsconfig.scripts.json scripts/assets/compressAssets.ts",
    "kebabify-content": "npx tsx --tsconfig tsconfig.scripts.json scripts/content/kebabifyContent.ts",
    "md-to-mdx": "npx tsx --tsconfig tsconfig.scripts.json scripts/content/mdToMdx.ts",
    "find-reusable-mdx-outliers": "npx tsx --tsconfig tsconfig.scripts.json --import ./scripts/utils/scssShim.ts scripts/content/findReusableMdxOutliers/index.ts",
    "clean-fullsize-forced": "rm -rf public/full-size",
    "clean-fullsize": "npx tsx --tsconfig tsconfig.scripts.json scripts/build/cleanFullSize.ts",
    "merge-locales": "npx tsx --tsconfig tsconfig.scripts.json scripts/i18n/mergeMessages.ts",
    "clean-translations": "npx tsx --tsconfig tsconfig.scripts.json scripts/i18n/cleanTranslations.ts",
    "pre-init": "npm run compress-assets && npm run kebabify-content && npm run md-to-mdx && npm run generate-metadata && npm run merge-locales && npm run find-reusable-mdx-outliers",
    "pre-init:ci": "npm run kebabify-content && npm run md-to-mdx && npm run generate-metadata && npm run merge-locales && npm run find-reusable-mdx-outliers:ci",
    "find-reusable-mdx-outliers:ci": "npx tsx --tsconfig tsconfig.scripts.json scripts/content/findReusableMdxOutliers/ci.ts",
    "clean-metadata": "find src/content -name '*.metadata.json' -delete && find scripts/core -name '*.metadata.json' -delete && rm -rf .meta/en .meta/runtime",
    "clean": "npm run clean-fullsize && npm run clean-translations && rm -rf ./stl",
    "build": "rm -rf .next/cache && npm run pre-init && npm run test && next build",
    "build:ci": "rm -rf .next/cache && npm run pre-init:ci && npm run test && next build",
    "fetch-content": "npx tsx --tsconfig tsconfig.scripts.json scripts/build/fetchContent.ts",
    "build:vercel": "npm run fetch-content && rm -rf .next && npm run pre-init && next build",
    "generate-metadata": "npx tsx --tsconfig tsconfig.scripts.json scripts/metadata/generateMetadata.ts",
    "foundry:export": "npx tsx --tsconfig tsconfig.scripts.json foundry/scripts/export.ts",
    "foundry:pack": "npx tsx --tsconfig tsconfig.scripts.json foundry/scripts/compilePacks.ts",
    "foundry:build": "npm run foundry:export && npm run foundry:pack",
    "db:init": "npx tsx --tsconfig tsconfig.scripts.json scripts/db/pg/init-db.ts",
    "db:migrate": "npx tsx scripts/db/pg/migrate.ts",
    "db:migrate:down": "npx tsx scripts/db/pg/migrate.ts --down",
    "db:seed": "npx tsx scripts/db/pg/seed-from-fs.ts",
    "db:backfill-spell-lists": "npx tsx --tsconfig tsconfig.scripts.json scripts/db/pg/backfill-spell-lists.ts",
    "setup": "npx tsx --tsconfig tsconfig.scripts.json scripts/multirepo/ik.ts setup",
    "postinstall": "npx tsx --tsconfig tsconfig.scripts.json scripts/bootstrap/postinstall.ts",
    "health:check": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/health-check.ts",
    "health:file-length": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/check-file-length.ts",
    "health:duplicate-css": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/check-duplicate-css.ts",
    "health:jsdoc": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/check-jsdoc-quality.ts",
    "health:antipatterns": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/check-antipatterns.ts",
    "health:test-gaps": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/check-test-gaps.ts",
    "health:reconcile": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/reconcile-task.ts",
    "health:report": "npx tsx --tsconfig tsconfig.scripts.json .github/scripts/write-report.ts",
    "pretest": "npm run test:enforce",
    "test": "npx tsx --tsconfig tsconfig.scripts.json tests/scripts/runTests.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=vitest-report.json",
    "test:unit": "vitest run --project unit:components --project unit:utils --project unit:db --project unit:hooks --project unit:metadata --project unit:api --project unit:app --project unit:other",
    "test:integration": "vitest run --project integration",
    "test:file": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual --update-snapshots",
    "test:enforce": "npx tsx --tsconfig tsconfig.scripts.json tests/scripts/enforceCoverage.ts",
    "test:templates": "npx tsx --tsconfig tsconfig.scripts.json tests/scripts/generateTestTemplates.ts",
    "test:all": "npm run test && npm run test:e2e",
    "test:components": "vitest run --project unit:components",
    "test:utils": "vitest run --project unit:utils",
    "test:db": "vitest run --project unit:db",
    "test:hooks-unit": "vitest run --project unit:hooks",
    "test:metadata": "vitest run --project unit:metadata",
    "test:api": "vitest run --project unit:api",
    "test:app": "vitest run --project unit:app",
    "test:other": "vitest run --project unit:other",
    "test:hooks": "bash .paw/git-hooks/test-hooks.sh",
    "paw": "node .github/PAW/dist/cli.mjs",
    "paw:status": "node .github/PAW/dist/cli.mjs status",
    "paw:violations": "node .github/PAW/dist/cli.mjs violations ls",
    "paw:unblock": "node .github/PAW/dist/cli.mjs violations prune",
    "paw:enable": "node .github/PAW/dist/cli.mjs state enable",
    "paw:disable": "node .github/PAW/dist/cli.mjs state disable",
    "paw:db:reset": "node .github/PAW/dist/cli.mjs db reset",
    "paw:db:stats": "node .github/PAW/dist/cli.mjs db stats",
    "paw:set-password": "node .github/PAW/dist/cli.mjs set-password"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mikro-orm/core": "^6.6.9",
    "@mikro-orm/postgresql": "^6.6.9",
    "@neondatabase/serverless": "^1.0.2",
    "@next/mdx": "^15.3.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/pg": "^8.18.0",
    "@types/three": "^0.183.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.576.0",
    "mdx-bundler": "^10.1.1",
    "next": "^15.4.8",
    "next-intl": "^4.3.4",
    "next-mdx-remote-client": "^2.1.2",
    "pg": "^8.20.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-simple-code-editor": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.89.2",
    "three": "^0.183.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.3",
    "@github/copilot-sdk": "^0.2.2",
    "@mikro-orm/reflection": "^6.6.9",
    "@playwright/test": "^1.40.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.39",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "4.0.18",
    "acorn": "^8.11.3",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.2",
    "autoprefixer": "^10",
    "dotenv": "^17.3.1",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^8",
    "eslint-config-next": "^15.4.0",
    "globby": "^14.1.0",
    "happy-dom": "^20.8.4",
    "is-arguments": "^1.1.1",
    "jsdom": "^27.2.0",
    "node-fetch": "^3.3.2",
    "pagefind": "^1.4.0",
    "playwright": "^1.54.1",
    "postcss": "^8",
    "sharp": "^0.34.3",
    "tailwindcss": "^3",
    "ts-morph": "^26.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
