# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json

# testing
/coverage
/playwright-report
/test-results
vitest-report.json

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem
/.ignore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
/.logs
*.log

#these are autogenerated
/public/library/images
/messages/**/index.json
/src/compiled-content
/src/lib/components/mdx/mdxComponents.tsx
/temp/
/temp/*.ts.json

# pre-commit hook security patterns (never commit)
scripts/hooks/.patterns
*.bak
/src/**/*.metadata.json
/.meta/
.paw
.github/PAW
.pawignore

# foundry vtt compiled packs and build output (source JSON is tracked)
/foundry/packs/_source/
/foundry/packs/monsters/
/foundry/packs/heirlooms/
/foundry/packs/spells/
/foundry/packs/trinkets/
/foundry/dist/
