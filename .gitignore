# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json

# testing
/coverage
/playwright-report
/test-results
vitest-report.json

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem
/.ignore
*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
/.logs
*.log

#these are autogenerated
/public/library/images
/messages/**/index.json
/src/compiled-content
/src/lib/components/mdx/mdxComponents.tsx
/temp/
/temp/*.ts.json
**/output/**/*.txt

# pre-commit hook security patterns (never commit)
.paw/git-hooks/.patterns
*.bak
/src/**/*.metadata.json
/.meta/

# PAW runtime artifacts (framework core + project config are TRACKED)
/.paw/paw.sqlite
/.paw/paw.sqlite-shm
/.paw/paw.sqlite-wal
/.paw/paw.log
/.paw/.pawsecret
/.paw/node_modules
/.paw/hooks
/.paw/gateWrapper.ts
/.paw/gateContext.ts
/.paw/healthCheckTypes.ts
/.paw/daemon.token
/.paw/daemon.log
/.paw/console.endpoint.json
/.paw/*.provider.env
*.lock

# foundry vtt compiled packs and build output (source JSON is tracked)
/foundry/packs/_source/
/foundry/packs/monsters/
/foundry/packs/heirlooms/
/foundry/packs/spells/
/foundry/packs/trinkets/
/foundry/assets/images/
/foundry/assets/tokens/
/foundry/dist/

# Pagefind search index (built at build time)
public/pagefind/

.mdx-plugins
