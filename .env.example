# ── Corrections Module ──────────────────────────────────────────
# HMAC signing secret for capability tokens (generate yourself, min 32 chars)
CORRECTIONS_SECRET=

# GitHub PAT with Contents + Pull Requests write access to the content repo
GITHUB_PAT=

# Content repo coordinates
CONTENT_REPO_OWNER=Typeir
CONTENT_REPO_NAME=ikuisuus-content

# ── Vercel Edge Config (audit logging) ──────────────────────────
# EDGE_CONFIG is set automatically when you link an Edge Config store in Vercel.
# EDGE_CONFIG_ID and VERCEL_API_TOKEN are needed for write operations.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
METADATA_BACKEND=pg

# Recommended for most uses
DATABASE_URL=***

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=***

# Parameters for constructing your own connection string
PGHOST=***
PGHOST_UNPOOLED=***
PGUSER=***
PGDATABASE=***
PGPASSWORD=***

# Parameters for Vercel Postgres Templates
POSTGRES_URL=***
POSTGRES_URL_NON_POOLING=***
POSTGRES_USER=***
POSTGRES_HOST=***
POSTGRES_PASSWORD=***
POSTGRES_DATABASE=***
POSTGRES_URL_NO_SSL=***
POSTGRES_PRISMA_URL=***