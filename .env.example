# ── Corrections Module ──────────────────────────────────────────
# HMAC signing secret for capability tokens (generate yourself, min 32 chars)
CORRECTIONS_SECRET=

# GitHub PAT with Contents + Pull Requests write access to the content repo
GITHUB_PAT=

# Content repo coordinates
CONTENT_REPO_OWNER=Typeir
CONTENT_REPO_NAME=ikuisuus-content

# ── Content Webhook / Revalidation ──────────────────────────────
# Shared secrets for content repo GitHub Actions → main app communication
# REVALIDATION_SECRET: used by auto-merge workflow to trigger ISR revalidation
# CONTENT_WEBHOOK_SECRET: used by content-check workflow to ban IPs on profanity
# SITE_URL: production URL (set as GitHub repo secret, not here)
REVALIDATION_SECRET=
CONTENT_WEBHOOK_SECRET=

# ── Storage Backend ─────────────────────────────────────────────
# METADATA_BACKEND selects the persistence layer for auth, audit, and banned IPs.
# Supported values: fs (default, local JSON files), pg (PostgreSQL).
# When set to 'fs', data is stored in .meta/runtime/ (gitignored).
METADATA_BACKEND=pg

# Required when METADATA_BACKEND=pg
DATABASE_URL=***

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=***

# Parameters for constructing your own connection string
PGHOST=***
PGHOST_UNPOOLED=***
PGUSER=***
PGDATABASE=***
PGPASSWORD=***

# Parameters for Vercel Postgres Templates
POSTGRES_URL=***
POSTGRES_URL_NON_POOLING=***
POSTGRES_USER=***
POSTGRES_HOST=***
POSTGRES_PASSWORD=***
POSTGRES_DATABASE=***
POSTGRES_URL_NO_SSL=***
POSTGRES_PRISMA_URL=***