// Prisma schema for Library of Ikuisuus
//
// datasource: Neon / Postgres (DATABASE_URL in environment)
// generator:  prisma-client-js
//
// NOTE: The monsters table has one expression-based unique index that Prisma
// cannot model in the schema file:
//
//   CREATE UNIQUE INDEX monsters_locale_display_slug_uidx
//     ON monsters (locale, COALESCE(sub_slug, slug));
//
// This index is maintained exclusively via scripts/db/init-db.mjs and
// scripts/db/migrations/. Do NOT remove it from those files.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/lib/db/prisma/generated/sql"
}

// ─────────────────────────────  AUTH  ────────────────────────────────────────

/// Auth user persisted in corrections_users.
model CorrectionsUser {
  id           String    @id
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("editor")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()

  @@map("corrections_users")
}

// ─────────────────────────────  MONSTERS  ────────────────────────────────────

/// One row per stat block. Multi-stat-block source files use subSlug as the
/// canonical lookup key; slug identifies the source file.
model Monster {
  id              Int      @id @default(autoincrement())
  locale          String
  slug            String
  subSlug         String?  @map("sub_slug")
  title           String
  file            String
  link            String

  // Core descriptor
  size            String?
  creatureType    String?  @map("creature_type")
  alignment       String?
  cr              String?
  proficiencyBonus Int?    @map("proficiency_bonus") @db.SmallInt

  // Armor Class
  acValue         Int?     @map("ac_value") @db.SmallInt
  acNotes         String?  @map("ac_notes")
  acRaw           String?  @map("ac_raw")

  // Hit Points
  hpAverage       Int?     @map("hp_average") @db.SmallInt
  hpFormula       String?  @map("hp_formula")
  hpRaw           String?  @map("hp_raw")

  // Speed
  speedRaw        String?  @map("speed_raw")
  speedWalk       Int?     @map("speed_walk") @db.SmallInt
  speedFly        Int?     @map("speed_fly") @db.SmallInt
  speedClimb      Int?     @map("speed_climb") @db.SmallInt
  speedSwim       Int?     @map("speed_swim") @db.SmallInt
  speedBurrow     Int?     @map("speed_burrow") @db.SmallInt
  speedHover      Boolean? @map("speed_hover")

  // Ability Scores (modifiers are NOT stored — derive via floor((score-10)/2))
  strScore        Int?     @map("str_score") @db.SmallInt
  dexScore        Int?     @map("dex_score") @db.SmallInt
  conScore        Int?     @map("con_score") @db.SmallInt
  intScore        Int?     @map("int_score") @db.SmallInt
  wisScore        Int?     @map("wis_score") @db.SmallInt
  chaScore        Int?     @map("cha_score") @db.SmallInt

  // Saving Throws
  saveStr         Int?     @map("save_str") @db.SmallInt
  saveDex         Int?     @map("save_dex") @db.SmallInt
  saveCon         Int?     @map("save_con") @db.SmallInt
  saveInt         Int?     @map("save_int") @db.SmallInt
  saveWis         Int?     @map("save_wis") @db.SmallInt
  saveCha         Int?     @map("save_cha") @db.SmallInt

  // Senses
  sensesRaw          String?  @map("senses_raw")
  passivePerception  Int?     @map("passive_perception") @db.SmallInt
  darkvision         Int?     @db.SmallInt
  blindsight         Int?     @db.SmallInt
  tremorsense        Int?     @db.SmallInt
  truesight          Int?     @db.SmallInt

  // Arrays
  skills               String[]
  damageResistances    String[] @map("damage_resistances")
  damageImmunities     String[] @map("damage_immunities")
  damageVulnerabilities String[] @map("damage_vulnerabilities")
  conditionImmunities  String[] @map("condition_immunities")
  languages            String[]
  tags                 String[]

  indexVersion         Int?     @map("index_version") @db.SmallInt

  // Simple indexes — expression-based COALESCE unique index is DDL-only (see top note)
  @@index([locale, slug], map: "monsters_locale_slug_idx")
  @@index([locale, cr], map: "monsters_locale_cr_idx")
  @@index([locale, creatureType], map: "monsters_locale_type_idx")
  @@map("monsters")
}

// ─────────────────────────────  HEIRLOOMS  ───────────────────────────────────

/// Magical items and equipment.
model Heirloom {
  id                     Int      @id @default(autoincrement())
  locale                 String
  slug                   String
  title                  String
  file                   String
  link                   String

  rarity                 String?
  itemType               String?  @map("item_type")
  weaponType             String?  @map("weapon_type")
  requiresAttunement     Boolean? @map("requires_attunement")
  attunementRequirements String?  @map("attunement_requirements")

  // Weapon damage (flattened from HeirloomWeaponDamage)
  weaponDamage           String?  @map("weapon_damage")
  weaponDamageType       String?  @map("weapon_damage_type")
  versatileDamage        String?  @map("versatile_damage")

  hitModifier      Int?     @map("hit_modifier") @db.SmallInt
  range            String?
  weight           String?
  chargesInitial   String?  @map("charges_initial")
  chargesRecharge  String?  @map("charges_recharge")
  chargesDepletes  Boolean? @map("charges_depletes")

  mastery          String[]
  weaponProperties String[] @map("weapon_properties")
  damageTypesDealt String[] @map("damage_types_dealt")
  savingThrowTypes String[] @map("saving_throw_types")
  tags             String[]
  indexVersion     Int?     @map("index_version") @db.SmallInt

  @@unique([locale, slug])
  @@index([locale, rarity], map: "heirlooms_locale_rarity_idx")
  @@index([locale, itemType], map: "heirlooms_locale_item_type_idx")
  @@map("heirlooms")
}

// ─────────────────────────────  SPELLS  ──────────────────────────────────────

/// Spell entry. Spell-list memberships live in SpellList (spell_lists table).
model Spell {
  id                  Int         @id @default(autoincrement())
  locale              String
  slug                String
  title               String
  file                String
  link                String

  level               Int?        @db.SmallInt
  school              String?
  quality             String?
  castingTimeRaw      String?     @map("casting_time_raw")
  range               String?
  concentration       Boolean?
  duration            String?
  verbal              Boolean?
  somatic             Boolean?
  material            Boolean?
  materialDescription String?     @map("material_description")
  hasRitual           Boolean?    @map("has_ritual")

  castingTime         String[]    @map("casting_time")
  tags                String[]

  spellLists          SpellList[]

  @@unique([locale, slug])
  @@index([locale, level], map: "spells_locale_level_idx")
  @@index([locale, school], map: "spells_locale_school_idx")
  @@map("spells")
}

/// Normalised spell-list membership (one row per class that can cast a spell).
model SpellList {
  id      Int    @id @default(autoincrement())
  spellId Int    @map("spell_id")
  name    String
  link    String

  spell   Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@index([spellId], map: "spell_lists_spell_id_idx")
  @@map("spell_lists")
}

// ─────────────────────────────  TRINKETS  ────────────────────────────────────

/// Consumable / minor magic items.
model Trinket {
  id                  Int      @id @default(autoincrement())
  locale              String
  slug                String
  title               String
  file                String
  link                String

  itemType            String   @map("item_type")
  damage              String?
  damageType          String?  @map("damage_type")
  range               String?
  weight              String?
  savingThrowDc       Int?     @map("saving_throw_dc") @db.SmallInt
  savingThrowAbility  String?  @map("saving_throw_ability")

  properties         String[]
  specialEffects     String[] @map("special_effects")
  inflictsConditions String[] @map("inflicts_conditions")
  tags               String[]

  @@unique([locale, slug])
  @@index([locale, itemType], map: "trinkets_locale_item_type_idx")
  @@map("trinkets")
}

// ─────────────────────────────  MIGRATIONS  ──────────────────────────────────

/// Tracks which SQL migration files in scripts/db/migrations/ have been applied.
model SchemaMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz()

  @@map("schema_migrations")
}
