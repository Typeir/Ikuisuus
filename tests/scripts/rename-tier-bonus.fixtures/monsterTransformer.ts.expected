/**
 * Monster → dnd5e NPC JSON transformer for Foundry VTT export.
 */

interface MonsterMetadata {
  name: string;
  tierBonus?: number;
  strScore?: number;
  dexScore?: number;
  cr?: string;
}

/**
 * Compute the dnd5e skill proficiency multiplier (0, 0.5, 1, 2)
 * from the difference between total bonus and ability modifier.
 */
function computeSkillProf(bonus: number, mod: number, prof: number): number {
  const diff = bonus - mod;
  if (diff === 0 || prof === 0) return 0;
  const ratio = diff / prof;
  if (ratio >= 2) return 2;
  if (ratio >= 1) return 1;
  if (ratio >= 0.5) return 0.5;
  return 0;
}

export function transformMonster(m: MonsterMetadata): Record<string, unknown> {
  const prof = m.tierBonus ?? 2;

  return {
    name: m.name,
    'data.attributes.prof': prof,
  };
}
